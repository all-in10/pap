{
  "openapi": "3.0.0",
  "info": {
    "title": "TeamCore HR Management API",
    "description": "REST API for TeamCore HR Management System - Complete employee management, contracts, timeoffs, and audit logging",
    "version": "1.0.0",
    "contact": {
      "name": "TeamCore Support",
      "url": "https://teamcore.local",
      "email": "support@teamcore.local"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000/api/v1",
      "description": "Development Server"
    },
    {
      "url": "https://teamcore.local/api/v1",
      "description": "Production Server"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Employee": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "first_name": {
            "type": "string"
          },
          "last_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "department_id": {
            "type": "integer"
          },
          "designation_id": {
            "type": "integer"
          }
        }
      },
      "Contract": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee_id": {
            "type": "integer"
          },
          "contract_type_id": {
            "type": "integer"
          },
          "salary": {
            "type": "number"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["active", "terminated", "suspended"]
          }
        }
      },
      "Timeoff": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee_id": {
            "type": "integer"
          },
          "type": {
            "type": "string",
            "enum": ["vacation", "sick_leave", "personal_leave", "other"]
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "Worklog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "employee_id": {
            "type": "integer"
          },
          "work_date": {
            "type": "string",
            "format": "date"
          },
          "start_time": {
            "type": "string",
            "format": "time"
          },
          "end_time": {
            "type": "string",
            "format": "time"
          },
          "hours_worked": {
            "type": "number"
          }
        }
      },
      "AuditLog": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "user_id": {
            "type": "integer"
          },
          "action": {
            "type": "string",
            "enum": ["created", "updated", "deleted"]
          },
          "model_type": {
            "type": "string"
          },
          "model_id": {
            "type": "integer"
          },
          "changes": {
            "type": "object"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "errors": {
            "type": "object"
          }
        }
      }
    }
  },
  "paths": {
    "/auth/login": {
      "post": {
        "summary": "User Login",
        "tags": ["Authentication"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials"
          }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Get Current User",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "Current user data"
          }
        }
      }
    },
    "/employees": {
      "get": {
        "summary": "List Employees",
        "tags": ["Employees"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "department_id",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of employees"
          }
        }
      },
      "post": {
        "summary": "Create Employee",
        "tags": ["Employees"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Employee"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Employee created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          }
        }
      }
    },
    "/employees/{id}": {
      "get": {
        "summary": "Get Employee",
        "tags": ["Employees"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Employee data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Employee"
                }
              }
            }
          },
          "404": {
            "description": "Employee not found"
          }
        }
      },
      "put": {
        "summary": "Update Employee",
        "tags": ["Employees"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Employee"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Employee updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Employee",
        "tags": ["Employees"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Employee deleted"
          }
        }
      }
    },
    "/timeoffs": {
      "get": {
        "summary": "List Timeoff Requests",
        "tags": ["Timeoffs"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of timeoffs"
          }
        }
      },
      "post": {
        "summary": "Request Timeoff",
        "tags": ["Timeoffs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Timeoff"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Timeoff request created"
          }
        }
      }
    },
    "/timeoffs/{id}": {
      "get": {
        "summary": "Get Timeoff",
        "tags": ["Timeoffs"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeoff data"
          }
        }
      },
      "put": {
        "summary": "Update Timeoff",
        "tags": ["Timeoffs"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeoff updated"
          }
        }
      },
      "delete": {
        "summary": "Delete Timeoff",
        "tags": ["Timeoffs"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Timeoff deleted"
          }
        }
      }
    },
    "/worklogs": {
      "get": {
        "summary": "List Worklogs",
        "tags": ["Worklogs"],
        "responses": {
          "200": {
            "description": "List of worklogs"
          }
        }
      },
      "post": {
        "summary": "Create Worklog",
        "tags": ["Worklogs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Worklog"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Worklog created"
          }
        }
      }
    },
    "/audit-logs": {
      "get": {
        "summary": "List Audit Logs",
        "tags": ["Audit"],
        "parameters": [
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of audit logs"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Authentication",
      "description": "User authentication endpoints"
    },
    {
      "name": "Employees",
      "description": "Employee management endpoints"
    },
    {
      "name": "Timeoffs",
      "description": "Timeoff request endpoints"
    },
    {
      "name": "Worklogs",
      "description": "Work hour tracking endpoints"
    },
    {
      "name": "Audit",
      "description": "Audit logging endpoints"
    }
  ]
}
